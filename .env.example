# Copie este arquivo para .env e ajuste os valores.
# O .env fica fora do Git (.gitignore). Nunca versione credenciais reais.

# Site de demonstração público "The Internet", feito para praticar automação.
# Usuário e senha abaixo são os de teste publicados pelo próprio site.
WEBFLOW_URL=https://the-internet.herokuapp.com/login
WEBFLOW_USUARIO=tomsmith
WEBFLOW_SENHA=SuperSecretPassword!

# true = navegador invisível (servidores, agendamentos); false = mostra o navegador
WEBFLOW_HEADLESS=false

# Pausa entre etapas, para acompanhar a execução (milissegundos)
WEBFLOW_DELAY_MS=800

# Tempo máximo de espera por elemento (milissegundos)
WEBFLOW_TIMEOUT_MS=10000
